__pycache__/
*.py[cod]
.venv/
.env
.env.*
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# Runtime/generated outputs
artifacts/*
!artifacts/.gitkeep
outputs/*
